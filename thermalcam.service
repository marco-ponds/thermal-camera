[Unit]
Description=Thermal camera (PiTFT framebuffer UI)
After=local-fs.target systemd-udev-settle.service
# Keep retrying: the SPI display can appear a little after boot.
StartLimitIntervalSec=0

[Service]
User=__USER__
SupplementaryGroups=video input i2c gpio
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__DIR__/.venv/bin/python __DIR__/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
